generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String

  refreshToken String? @map("refresh_token")
  resetCode    String? @map("reset_code")
  resetCodeExpires DateTime? @map("reset_code_expires")

  products   Product[]
  categories Category[]
  familyMembers FamilyMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Family {
  id   String @id @default(uuid())
  name String

  inviteCode        String?   @unique @map("invite_code")
  inviteCodeExpires DateTime? @map("invite_code_expires")

  members    FamilyMember[]
  products   Product[]
  categories Category[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("families")
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

model FamilyMember {
  id   String     @id @default(uuid())
  role FamilyRole @default(MEMBER)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, familyId])
  @@map("family_members")
}

enum ProductType {
  MAIN
  ACCESSORY
}

model Product {
  id           String    @id @default(uuid())
  name         String
  brand        String?
  model        String?
  size         String?
  purchaseDate DateTime?
  price        Decimal?
  notes        String?
  type         ProductType @default(MAIN)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  // Auto-relacionamento para produtos vinculados
  linkedProducts Product[] @relation("ProductLinks")
  linkedBy       Product[] @relation("ProductLinks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Category {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  @@map("categories")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  type      String   @default("PRODUCT") // PRODUCT ou LABEL
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
